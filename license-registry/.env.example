# Set secrets in the new Railway service Variables. Do not commit a populated .env.
# Use a dedicated bot token; never run two pollers with the existing bot's token.
BOT_TOKEN=

# Signed Bot API chat ID, verified using this bot's getChat response.
# Leave blank until confirmed; the export ID below is not a substitute.
TARGET_CHAT_ID=
SOURCE_CHAT_ID=5164597211

# JSON object from the dedicated Google service account. Share only the registry
# spreadsheet with its client_email as Editor. Keep private_key in Railway secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=
SPREADSHEET_ID=15je7KIryEg09thZVLpguVWXmWlxCsft2ULC6dc2m-vs
SHEET_NAME=Реестр лицензий
SHEET_ID=0

# Existing API-ФНС key. Runtime writes this to FSRAR_KEY_FILE with mode 0600.
FSRAR_API_KEY=
FSRAR_KEY_FILE=/data/secrets/api-fns-key

# Attach a dedicated Railway Volume at /data. Run exactly one replica.
STATE_FILE=/data/state.json
# Application configuration, not a Railway Config-as-Code file. Configure the
# Railway service itself through Dashboard/API; no railway.toml is used here.
CONFIG_FILE=/app/config.json
TIME_ZONE=Europe/Moscow
DAILY_HOUR=9

# Results and errors are written to Railway logs. No Telegram notifications are
# sent by this service; no owner notification chat is configured.

# true observes/plans without changing Google; false enables real processing.
DRY_RUN=false

# Railway supplies PORT automatically. No public domain is required for polling.
# PORT=8080
