# Set secrets in the new Railway service Variables. Do not commit a populated .env.
# Use a dedicated bot token; never run two pollers with the existing bot's token.
BOT_TOKEN=

# Signed Bot API chat ID, verified using this bot's getChat response.
# Leave blank until confirmed; the export ID below is not a substitute.
TARGET_CHAT_ID=
SOURCE_CHAT_ID=5164597211

# JSON object from the dedicated Google service account. Share only the registry
# spreadsheet with its client_email as Editor. Keep private_key in Railway secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=
SPREADSHEET_ID=15je7KIryEg09thZVLpguVWXmWlxCsft2ULC6dc2m-vs
SHEET_NAME=Реестр лицензий
SHEET_ID=0

# Existing API-ФНС key. Runtime writes this to FSRAR_KEY_FILE with mode 0600.
FSRAR_API_KEY=
FSRAR_KEY_FILE=/data/secrets/api-fns-key
# Optional: pin one of the assigned Fixie outbound IPv4 addresses. Only API-ФНС
# subprocess traffic uses this proxy; never use the balanced hostname here.
FSRAR_PROXY_URL=
# Only for an https:// numeric-IP proxy: original Fixie DNS name used for SNI
# and certificate verification. HTTP proxy + verified origin HTTPS needs no name.
FSRAR_PROXY_SERVER_NAME=

# Attach a dedicated Railway Volume at /data. Run exactly one replica.
STATE_FILE=/data/state.json
# Application configuration, not a Railway Config-as-Code file. Configure the
# Railway service itself through Dashboard/API; no railway.toml is used here.
CONFIG_FILE=/app/config.json
TIME_ZONE=Europe/Moscow
DAILY_HOUR=9

# Positive Telegram user ID, verified by getChat as a private owner conversation.
# The owner must start this dedicated bot first. Omit for Railway logs only.
NOTIFY_CHAT_ID=

# One-time private queue migration. Leave empty after the Volume has state.json.
# Never commit the real JSON or put it in Docker build arguments.
INITIAL_STATE_JSON=
REQUIRE_INITIAL_STATE=true

# Optional one-time operator-verified official card; leave empty in normal use.
OFFICIAL_LICENSE_EVIDENCE_JSON=

# Autonomous fill-empty M/N/O from existing bot requests. Requires private DB views.
CONTACT_SYNC_ENABLED=false
CONTACTS_CLIENTS_CHAT_ID=
# One-time reference to Postgres.DATABASE_URL for scoped reader provisioning.
# Clear after /data/secrets/contacts-db-url is verified and restart the service.
CONTACTS_BOOTSTRAP_DATABASE_URL=

# true observes/plans without changing Google; false enables real processing.
DRY_RUN=false

# Railway supplies PORT automatically. No public domain is required for polling.
# PORT=8080
